NODE_ENV=development
BUSINESS_HOST=127.0.0.1
BUSINESS_PORT=8787
# Auth0 staging: exact OIDC issuer, API Identifier audience, and tenant JWKS URL.
BUSINESS_ISSUER_URL=
BUSINESS_AUDIENCE=
BUSINESS_JWKS_URL=
BUSINESS_ALLOWED_HOSTS=localhost,127.0.0.1
# Keep disabled until Auth0 and a target remote MCP client are configured.
BUSINESS_OAUTH_DISCOVERY_ENABLED=false
BUSINESS_RESOURCE_URL=
BUSINESS_ALLOWED_ORIGINS=
BUSINESS_TRUST_PROXY=false
BUSINESS_RATE_LIMIT_PER_MINUTE=60
BUSINESS_GLOBAL_RATE_LIMIT_PER_MINUTE=300
BUSINESS_USER_RATE_LIMIT_PER_MINUTE=60
BUSINESS_MAX_CONCURRENT_HEALTH_CHECKS=20
AUDIT_LOG_PATH=./var/audit.jsonl

# Google Analytics Data API and Search Console API (read-only reporting).
# Use separate dedicated service accounts for local and cPanel environments. Grant each
# Viewer/read access only to its listed properties; keep private keys out of Git and chat.
GOOGLE_REPORTING_SERVICE_ACCOUNT_EMAIL=
GOOGLE_REPORTING_SERVICE_ACCOUNT_PRIVATE_KEY=
# Comma-separated system=GA4 numeric property ID entries (not G- measurement IDs).
GOOGLE_ANALYTICS_PROPERTY_IDS=
# Comma-separated system=GA4 numeric web/app stream ID entries. Required to keep
# reports separated when multiple sites share one GA4 property.
GOOGLE_ANALYTICS_STREAM_IDS=
# Comma-separated system=Search Console property entries; values are https:// URL-prefix
# properties or sc-domain:example.com domain properties.
GOOGLE_SEARCH_CONSOLE_SITES=

# Optional local project path overrides. MCP1 never reads .env files within projects.
PROJECT_ULTERPOS_PATH=/home/seint/Dev/Work/pos/ulterpos
PROJECT_TRANQUIL_PATH=/home/seint/Dev/Work/tranquil
PROJECT_ULTERNET_PATH=/home/seint/Dev/Self/Apps/UlterNet-Systems/Company/UlterNet/website/devspark
PROJECT_SOCIAL_APPS_PATH=/home/seint/Dev/Self/Apps/UlterNet-Systems/Social/social-apps
PROJECT_RENEGADE_PATH=/home/seint/Dev/Self/Apps/UlterNet-Systems/Tickets&Events/renegade/website/renegade

# Business health checks are opt-in. Use HTTPS endpoints protected for this service.
SYSTEM_ULTERPOS_HEALTH_URL=
SYSTEM_ULTERPOS_HEALTH_TOKEN=
SYSTEM_TRANQUIL_HEALTH_URL=
SYSTEM_TRANQUIL_HEALTH_TOKEN=
SYSTEM_ULTERNET_HEALTH_URL=
SYSTEM_ULTERNET_HEALTH_TOKEN=
SYSTEM_SOCIAL_APPS_HEALTH_URL=
SYSTEM_SOCIAL_APPS_HEALTH_TOKEN=
SYSTEM_RENEGADE_HEALTH_URL=
SYSTEM_RENEGADE_HEALTH_TOKEN=
